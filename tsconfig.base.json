{
  // The shared strict settings (#29). Each package's tsconfig.json `extends`
  // this file and adds its own `include` and `types`. tsconfig files allow comments.
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    // "bundler" resolves imports the way Bun does: package `exports` maps, and
    // no file extension needed on relative imports.
    "moduleResolution": "bundler",
    // Lets a relative import name the `.ts` file itself (needed by code that
    // also runs on Node, which does not guess extensions).
    "allowImportingTsExtensions": true,
    // Each file must make sense on its own once types are stripped, which is
    // how Bun and Node run TypeScript (no whole-program compile).
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    // `arr[i]` and `record[key]` get type `T | undefined`, forcing a check.
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  }
}
