{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(npm publish *)",
      "Bash(bun publish *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh release create *)",
      "Bash(gh secret *)",
      "Bash(gh api -X DELETE *)"
    ],
    "ask": ["Bash(gh pr merge *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
