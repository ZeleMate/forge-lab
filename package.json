{
  "name": "forge-lab",
  "private": true,
  "license": "MIT",
  "description": "Cartographer on a local TrueForge. Bun workspaces: one lockfile (bun.lock) and one bunfig.toml at this root.",
  "workspaces": [
    "agents",
    "app",
    "harness",
    "lib",
    "mcp"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "apply": "bun scripts/apply.ts",
    "smoke:mcp": "bun run --filter @forge-lab/mcp smoke",
    "snapshot": "bun scripts/snapshot.ts ensure",
    "snapshot:pin": "bun scripts/snapshot.ts pin",
    "check:pins": "bun scripts/check-pins.ts",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@forge-lab/agents": "workspace:*",
    "@forge-lab/lib": "workspace:*",
    "@truefoundry/trueforge-sdk": "0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "//overrides": "@assistant-ui/store and tap match TrueForge's own pnpm-lock.yaml: newer versions make TrueForgeUI loop forever on mount. app/src/overrides.test.ts fails if a TrueForge bump moves them.",
  "overrides": {
    "@assistant-ui/store": "0.2.21",
    "@assistant-ui/tap": "0.9.5",
    "body-parser": "2.4.0",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "node-forge": "1.4.3",
    "qs": "6.16.2",
    "undici": "7.30.1"
  }
}
