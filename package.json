{
  "name": "forge-lab",
  "private": true,
  "description": "Cartographer on a local TrueForge. Bun workspaces: one lockfile (bun.lock) and one bunfig.toml at this root.",
  "workspaces": [
    "harness",
    "lib"
  ],
  "scripts": {
    "snapshot": "bun scripts/snapshot.ts ensure",
    "snapshot:pin": "bun scripts/snapshot.ts pin",
    "check:pins": "bun scripts/check-pins.ts",
    "audit": "bun scripts/audit.ts",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit && bun run --filter '*' typecheck",
    "check": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@forge-lab/lib": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "^7.0.2"
  }
}
