{
  "name": "@forge-lab/mcp",
  "private": true,
  "description": "Cartographer's MCP server (#8): one Bun process on 127.0.0.1:8791 with the source, sessions and triage endpoints. The root `bun run dev` starts it. TypeScript source, no build step.",
  "type": "module",
  "scripts": {
    "approvals:check": "bun scripts/approvals-check.ts",
    "fixtures:record": "bun scripts/fixtures-record.ts",
    "smoke": "bun scripts/smoke.ts",
    "triage:record": "bun --env-file=.env scripts/triage-record.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge-lab/lib": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@truefoundry/trueforge-sdk": "0.180.0",
    "openai": "7.45.1",
    "ts-morph": "28.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
